@page "/"
@implements IDisposable
@inject ISampleStore Store

<PageTitle>NetPulse</PageTitle>

<header class="top">
    <h1>NetPulse</h1>
    <nav class="windows">
        @foreach (var window in Windows)
        {
            <button class="@(window == _window ? "active" : null)" @onclick="() => SetWindowAsync(window)">
                @Label(window)
            </button>
        }
    </nav>
</header>

<main>
    @if (_series.Count == 0)
    {
        <p class="empty">Waiting for the first samples…</p>
    }

    @foreach (var series in _series)
    {
        <section class="card">
            <div class="card-head">
                <h2>@series.Target</h2>
                <span class="badge @series.Stats.Quality.ToString().ToLowerInvariant()">@series.Stats.Quality</span>
            </div>

            <dl class="stats">
                <div><dt>Avg</dt><dd>@Ms(series.Stats.AvgMs)</dd></div>
                <div><dt>Min</dt><dd>@Ms(series.Stats.MinMs)</dd></div>
                <div><dt>Max</dt><dd>@Ms(series.Stats.MaxMs)</dd></div>
                <div><dt>Jitter</dt><dd>@Ms(series.Stats.JitterMs)</dd></div>
                <div><dt>Loss</dt><dd>@series.Stats.LossPercent.ToString("0.#", CultureInfo.InvariantCulture) %</dd></div>
                <div><dt>Samples</dt><dd>@series.Stats.Count</dd></div>
            </dl>

            <LatencyChart Samples="series.Samples" From="_from" To="_to" WindowLabel="@Label(_window)" />
        </section>
    }
</main>

@code {
    private static readonly TimeSpan[] Windows =
    [
        TimeSpan.FromMinutes(15),
        TimeSpan.FromHours(1),
        TimeSpan.FromHours(24)
    ];

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private TimeSpan _window = Windows[0];
    private DateTimeOffset _from;
    private DateTimeOffset _to;
    private List<Series> _series = [];

    private sealed record Series(string Target, IReadOnlyList<PingSample> Samples, LatencyStats Stats);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _to = DateTimeOffset.UtcNow;
        _from = _to - _window;
        var samples = await Store.GetSinceAsync(_from);

        _series = samples
            .GroupBy(s => s.Target)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                var list = g.ToList();
                return new Series(g.Key, list, LatencyStats.From(list));
            })
            .ToList();
    }

    private static string Ms(double? value) =>
        value is null ? "–" : value.Value.ToString("0.0", CultureInfo.InvariantCulture) + " ms";

    private static string Label(TimeSpan window) =>
        window.TotalHours >= 1 ? $"{window.TotalHours:0}h" : $"{window.TotalMinutes:0}m";

    public void Dispose() => _cts.Cancel();
}
