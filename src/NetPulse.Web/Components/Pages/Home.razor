@page "/"
@implements IDisposable
@using NetPulse.Core.Probing
@using NetPulse.Core.Targets
@inject ISampleStore Store
@inject TargetManager Targets
@inject NetPulse.Web.Connection.LinkMonitor Link

<PageTitle>NetPulse</PageTitle>

<AppHeader>
    <nav class="windows">
        @foreach (var window in Windows)
        {
            <button class="@(window == _window ? "active" : null)" @onclick="() => SetWindowAsync(window)">
                @Label(window)
            </button>
        }
    </nav>
</AppHeader>

<main>
    <ConnectionCard Link="Link.Current" />

    <TargetEditor OnChanged="ReloadAsync" />

    @if (_series.Count == 0)
    {
        <p class="empty">Waiting for the first samples…</p>
    }

    @foreach (var series in _series)
    {
        <section class="card">
            <div class="card-head">
                <h2>
                    @series.Target
                    @if (_dualStack && series.Family != IpFamily.Any)
                    {
                        <small class="family">@series.Family</small>
                    }
                </h2>
                <span class="badge @series.Quality.ToString().ToLowerInvariant()">@series.Quality</span>
            </div>

            <dl class="stats">
                <div><dt>Avg</dt><dd>@Ms(series.Stats.AvgMs)<span class="unit">@Unit(series.Stats.AvgMs)</span></dd></div>
                <div><dt>Min</dt><dd>@Ms(series.Stats.MinMs)<span class="unit">@Unit(series.Stats.MinMs)</span></dd></div>
                <div><dt>Max</dt><dd>@Ms(series.Stats.MaxMs)<span class="unit">@Unit(series.Stats.MaxMs)</span></dd></div>
                <div><dt>Jitter</dt><dd>@Ms(series.Stats.JitterMs)<span class="unit">@Unit(series.Stats.JitterMs)</span></dd></div>
                <div><dt>Loss</dt><dd>@series.Stats.LossPercent.ToString("0.#", CultureInfo.InvariantCulture)<span class="unit">%</span></dd></div>
                <div><dt>Samples</dt><dd>@series.Stats.Count</dd></div>
            </dl>

            <LatencyChart Samples="series.Samples" From="_from" To="_to" WindowLabel="@Label(_window)" />
        </section>
    }
</main>

@code {
    private static readonly TimeSpan[] Windows =
    [
        TimeSpan.FromMinutes(15),
        TimeSpan.FromHours(1),
        TimeSpan.FromHours(24)
    ];

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private TimeSpan _window = Windows[0];
    private DateTimeOffset _from;
    private DateTimeOffset _to;
    private List<Series> _series = [];

    /// <summary>Samples of the current window, cached between refreshes so each tick only reads the new ones.</summary>
    private readonly SampleWindow _samples = new();

    /// <summary>True when IPv6 targets are monitored: then every card says which IP version it measures.</summary>
    private bool _dualStack;

    private sealed record Series(string Target, IReadOnlyList<PingSample> Samples, LatencyStats Stats)
    {
        /// <summary>Rated on the scale of the target's probe kind (ping, DNS or HTTP).</summary>
        public ConnectionQuality Quality => Stats.Rate(QualityThresholds.ForTarget(Target));

        public IpFamily Family => ProbeTarget.FamilyOf(Target);
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        await ReloadAsync();
    }

    /// <summary>Reads the whole window again: on start, when the window changes and when targets change.</summary>
    private Task ReloadAsync()
    {
        _samples.Clear();
        return LoadAsync();
    }

    /// <summary>
    /// Reads only the samples stored since the last load (the 24h window holds about 17,000 samples per
    /// target at the default 5 s interval) and drops those that slid out of the window.
    /// </summary>
    private async Task LoadAsync()
    {
        _to = DateTimeOffset.UtcNow;
        _from = _to - _window;

        // A clock set back would hide new samples behind the cached ones: start over.
        if (_samples.Latest > _to)
        {
            _samples.Clear();
        }

        var since = _samples.NextSince is { } next && next > _from ? next : _from;
        _samples.Add(await Store.GetSinceAsync(since));
        _samples.TrimBefore(_from);
        var monitored = new HashSet<string>(await Targets.GetEffectiveTargetsAsync(), StringComparer.OrdinalIgnoreCase);

        // Only show targets that are still monitored (a removed target may have a last in-flight sample).
        _series = _samples.Targets
            .Where(monitored.Contains)
            .OrderBy(target => target)
            .Select(target =>
            {
                var list = _samples.For(target);
                return new Series(target, list, LatencyStats.From(list));
            })
            .ToList();
        _dualStack = _series.Any(s => s.Family == IpFamily.IPv6);
    }

    private static string Ms(double? value) =>
        value is null ? "–" : value.Value.ToString("0.0", CultureInfo.InvariantCulture);

    private static string Unit(double? value) => value is null ? "" : "ms";

    private static string Label(TimeSpan window) =>
        window.TotalHours >= 1 ? $"{window.TotalHours:0}h" : $"{window.TotalMinutes:0}m";

    public void Dispose() => _cts.Cancel();
}
