@page "/outages"
@implements IDisposable
@using Microsoft.Extensions.Options
@using NetPulse.Core.Connection
@using NetPulse.Core.Notifications
@using NetPulse.Core.Outages
@using NetPulse.Core.PublicIp
@using NetPulse.Core.Discovery
@using NetPulse.Core.Targets
@using NetPulse.Web.Monitoring
@using NetPulse.Core.Traceroute
@inject IOutageStore Store
@inject IDegradationStore DegradationStore
@inject IOptions<DegradationOptions> DegradationOptions
@inject IOutageTraceStore TraceStore
@inject ILinkStore LinkStore
@inject TargetManager Targets
@inject IOptions<OutageOptions> Options
@inject IOptions<MonitorOptions> MonitorOptions
@inject IPublicIpStore PublicIpStore
@inject NetPulse.Web.PublicIp.PublicIpMonitor PublicIpMonitor

<PageTitle>Outages · NetPulse</PageTitle>

<AppHeader>
    <nav class="windows">
        @foreach (var window in Windows)
        {
            <button class="@(window == _window ? "active" : null)" @onclick="() => SetWindowAsync(window)">
                @Label(window)
            </button>
        }
    </nav>
</AppHeader>

<main>
    @if (_outages.Any(o => o.IsOngoing) || _degradations.Any(d => d.IsOngoing))
    {
        <section class="card alert" role="alert">
            <ul>
                @foreach (var outage in _outages.Where(o => o.IsOngoing))
                {
                    <li>
                        <strong>@outage.Target is unreachable</strong>
                        since @outage.Start.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)
                        (@DurationFormat.Format(outage.Duration(_to)), @outage.LostSamples lost pings).
                    </li>
                }
                @foreach (var period in _degradations.Where(d => d.IsOngoing))
                {
                    <li>
                        <strong>@period.Target is degraded</strong>
                        since @period.Start.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture):
                        @Degradation.Describe(period.Reasons) (@NotificationFactory.Values(period)).
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <div class="card-head">
            <h2>Timeline</h2>
            <span class="hint">An outage is @Threshold lost pings in a row (about @DurationFormat.Format(ThresholdTime)).</span>
        </div>

        @if (_targets.Count == 0)
        {
            <p class="empty">No targets yet.</p>
        }
        else
        {
            <OutageTimeline Targets="_targets" Outages="_outages" Degradations="_degradations" From="_from" To="_to"
                            WindowLabel="@Label(_window)" Markers="_ipMarkers" MarkersLabel="public IP" />
            <div class="legend timeline-legend">
                <span class="outage">Outage</span>
                @if (DegradationOptions.Value.Enabled)
                {
                    <span class="degraded">Degraded</span>
                }
            </div>
        }

        <div class="table-wrap">
            <table class="devices summary">
                <thead>
                    <tr>
                        <th scope="col">Target</th>
                        <th scope="col">Outages</th>
                        <th scope="col">Downtime</th>
                        <th scope="col">Longest</th>
                        <th scope="col">Degraded</th>
                        <th scope="col">Availability</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var target in _targets)
                    {
                        var summary = Summary(target);
                        <tr>
                            <td>@target</td>
                            <td>@summary.Count</td>
                            <td>@(summary.Count == 0 ? "–" : DurationFormat.Format(summary.Downtime))</td>
                            <td>@(summary.Longest is { } longest ? DurationFormat.Format(longest) : "–")</td>
                            <td>@DegradedTime(target)</td>
                            <td><span class="@AvailabilityClass(summary)">@Percent(summary.AvailabilityPercent)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (PublicIpMonitor.Enabled)
    {
        <section class="card">
            <div class="card-head">
                <h2>Public IP</h2>
                <span class="hint">
                    @_ipHistory.RealChanges.Count() changes in the last @Label(_window)@(_ipAfterOutages > 0 ? $", {_ipAfterOutages} right after an outage" : "")
                </span>
            </div>

            @if (PublicIpMonitor.Current is { } current)
            {
                <p class="public-ip">
                    <strong>@current.Address</strong>
                    <span class="hint" title="@Time(current.Timestamp)">since @RelativeTime.Format(current.Timestamp, _to)</span>
                    @if (PublicIpMonitor.Cgnat is { BehindCgnat: true } cgnat)
                    {
                        <span class="badge fair" title="Hop @cgnat.CgnatHop!.Number answered from @cgnat.CgnatHop.Address">behind carrier-grade NAT</span>
                    }
                    else if (PublicIpMonitor.Cgnat is { Answered: > 0 })
                    {
                        <span class="badge good">no carrier-grade NAT</span>
                    }
                </p>
                @if (PublicIpMonitor.Cgnat is { BehindCgnat: true })
                {
                    <p class="hint">
                        Your provider shares this address with other customers (carrier-grade NAT): port forwarding,
                        a home server or a VPN back home cannot be reached from the Internet. Many providers drop it on
                        request, sometimes for a fee, or offer IPv6.
                    </p>
                }
            }
            else
            {
                <p class="empty">Not read yet@(PublicIpMonitor.LastError is { } error ? $": {error}" : ".")</p>
            }

            @if (_ipHistory.RealChanges.Any())
            {
                <div class="table-wrap">
                    <table class="devices">
                        <thead>
                            <tr>
                                <th scope="col">Changed</th>
                                <th scope="col">From</th>
                                <th scope="col">To</th>
                                <th scope="col">Cause</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in _ipHistory.RealChanges.Reverse())
                            {
                                <tr>
                                    <td>@Time(change.Timestamp)</td>
                                    <td>@change.Previous</td>
                                    <td>@change.Address</td>
                                    <td>
                                        @if (change.CausedBy(_outages) is { } cause)
                                        {
                                            <span>after the outage of @cause.Target at @cause.Start.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                                        }
                                        else
                                        {
                                            <span class="hint">–</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (DegradationOptions.Value.Enabled)
    {
        <section class="card">
            <div class="card-head">
                <h2>Degraded periods</h2>
                <span class="hint">@_degradations.Count in the last @Label(_window)</span>
            </div>

            <p class="hint">
                The target answered, but badly: over @DegradationOptions.Value.WindowMinutes minutes the packet loss,
                latency or jitter was in the poor range, so calls stutter and pages load slowly. Pings lost during an
                outage do not count.
            </p>

            @if (_degradations.Count == 0)
            {
                <p class="empty">No degraded periods in this period.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="devices">
                        <thead>
                            <tr>
                                <th scope="col">Target</th>
                                <th scope="col">Started</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Why</th>
                                <th scope="col">Worst</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var period in _degradations.OrderByDescending(d => d.Start))
                            {
                                <tr>
                                    <td>@period.Target</td>
                                    <td>@Time(period.Start)</td>
                                    <td>
                                        @DurationFormat.Format(period.Duration(_to))
                                        @if (period.IsOngoing)
                                        {
                                            <span class="tag fair">ongoing</span>
                                        }
                                    </td>
                                    <td>@Degradation.Describe(period.Reasons)</td>
                                    <td class="hint">@NotificationFactory.Values(period)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="card">
        <div class="card-head">
            <h2>History</h2>
            <span class="hint">@_outages.Count in the last @Label(_window)</span>
        </div>

        @if (_outages.Count == 0)
        {
            <p class="empty">No outages in this period.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="devices">
                    <thead>
                        <tr>
                            <th scope="col">Target</th>
                            <th scope="col">Started</th>
                            <th scope="col">Ended</th>
                            <th scope="col">Duration</th>
                            <th scope="col">Lost pings</th>
                            <th scope="col">Connection</th>
                            <th scope="col">Route</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var outage in _outages.OrderByDescending(o => o.Start))
                        {
                            <tr>
                                <td>@outage.Target</td>
                                <td>@Time(outage.Start)</td>
                                <td>
                                    @if (outage.End is { } end)
                                    {
                                        @Time(end)
                                    }
                                    else
                                    {
                                        <span class="tag offline">ongoing</span>
                                    }
                                </td>
                                <td>@DurationFormat.Format(outage.Duration(_to))</td>
                                <td>@outage.LostSamples</td>
                                <td>
                                    @if (_links.At(outage.Start) is { } link)
                                    {
                                        <span class="link @LinkClass(link)">@link.Summary</span>
                                    }
                                    else
                                    {
                                        <span class="hint">–</span>
                                    }
                                </td>
                                <td>
                                    @if (_traces.Find(outage) is { } trace)
                                    {
                                        <details class="trace">
                                            <summary>@trace.Summary</summary>
                                            <ol>
                                                @foreach (var hop in trace.Hops)
                                                {
                                                    <li value="@hop.Number">
                                                        @if (hop.Address is null)
                                                        {
                                                            <span class="hint">* no answer</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@hop.Address</span>
                                                            <span class="hint">@Ms(hop.RttMs)</span>
                                                        }
                                                    </li>
                                                }
                                            </ol>
                                        </details>
                                    }
                                    else
                                    {
                                        <span class="hint">–</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@code {
    private static readonly TimeSpan[] Windows =
    [
        TimeSpan.FromHours(24),
        TimeSpan.FromDays(7),
        TimeSpan.FromDays(30)
    ];

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private TimeSpan _window = Windows[0];
    private DateTimeOffset _from;
    private DateTimeOffset _to;
    private IReadOnlyList<Outage> _outages = [];
    private IReadOnlyList<Degradation> _degradations = [];
    private TraceLookup _traces = TraceLookup.Empty;
    private List<string> _targets = [];

    private int Threshold => Math.Max(1, Options.Value.ConsecutiveLosses);

    private TimeSpan ThresholdTime => TimeSpan.FromSeconds(Threshold * Math.Max(1, MonitorOptions.Value.IntervalSeconds));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _to = DateTimeOffset.UtcNow;
        _from = _to - _window;
        _outages = await Store.GetSinceAsync(_from);
        _degradations = await DegradationStore.GetSinceAsync(_from);

        _ipHistory = new PublicIpHistory(await PublicIpStore.GetSinceAsync(_from));
        _ipAfterOutages = _ipHistory.AfterOutages(_outages);
        _ipMarkers = _ipHistory.RealChanges
            .Select(c => (c.Timestamp, $"{Time(c.Timestamp)}  public IP {c.Previous} → {c.Address}"))
            .ToList();
        _traces = _outages.Count == 0
            ? TraceLookup.Empty
            : new TraceLookup(await TraceStore.GetSinceAsync(_outages.Min(o => o.Start)));

        _links = _outages.Count == 0
            ? LinkHistory.Empty
            : new LinkHistory(await LinkStore.GetSinceAsync(_outages.Min(o => o.Start) - LinkHistory.MaxAge));

        // Monitored targets first, then targets that are gone but had outages in the window.
        _targets = TargetList.Merge(
            await Targets.GetEffectiveTargetsAsync(),
            _outages.Select(o => o.Target).Concat(_degradations.Select(d => d.Target)).ToList()).ToList();
    }

    private LinkHistory _links = LinkHistory.Empty;
    private PublicIpHistory _ipHistory = PublicIpHistory.Empty;
    private int _ipAfterOutages;
    private IReadOnlyList<(DateTimeOffset Time, string Tooltip)> _ipMarkers = [];

    /// <summary>A weak Wi-Fi signal is coloured as poor, so Wi-Fi trouble stands out in the history.</summary>
    private static string? LinkClass(LinkInfo link) => link.SignalQuality switch
    {
        ConnectionQuality.Poor => "poor",
        ConnectionQuality.Fair => "fair",
        _ => null,
    };

    /// <summary>Total degraded time of a target within the window.</summary>
    private string DegradedTime(string target)
    {
        var total = _degradations
            .Where(d => string.Equals(d.Target, target, StringComparison.OrdinalIgnoreCase))
            .Aggregate(TimeSpan.Zero, (sum, d) =>
            {
                var start = d.Start < _from ? _from : d.Start;
                var end = d.End ?? _to;
                return end > start ? sum + (end - start) : sum;
            });
        return total == TimeSpan.Zero ? "–" : DurationFormat.Format(total);
    }

    private OutageSummary Summary(string target) => OutageSummary.From(
        _outages.Where(o => string.Equals(o.Target, target, StringComparison.OrdinalIgnoreCase)), _from, _to);

    private static string AvailabilityClass(OutageSummary summary) => summary.AvailabilityPercent switch
    {
        >= 99.9 => "good",
        >= 99 => "fair",
        _ => "poor",
    };

    // Truncated, not rounded: 99.999 % must not read as 100 % when there was downtime.
    private static string Percent(double value) => value >= 100
        ? "100 %"
        : (Math.Floor(value * 100) / 100).ToString("0.00", CultureInfo.InvariantCulture) + " %";

    private static string Ms(double? value) =>
        value is null ? "" : value.Value.ToString("0", CultureInfo.InvariantCulture) + " ms";

    private static string Time(DateTimeOffset time) =>
        time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    private static string Label(TimeSpan window) =>
        window.TotalDays >= 1 && window.TotalHours > 24 ? $"{window.TotalDays:0}d" : $"{window.TotalHours:0}h";

    public void Dispose() => _cts.Cancel();
}
