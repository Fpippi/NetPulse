@page "/speed"
@implements IDisposable
@using Microsoft.Extensions.Options
@using NetPulse.Core.Discovery
@using NetPulse.Core.SpeedTest
@using NetPulse.Web.SpeedTest
@inject ISpeedTestStore Store
@inject IContractStore Contracts
@inject SpeedTestRunner Runner
@inject IOptions<SpeedTestOptions> Options

<PageTitle>Speed · NetPulse</PageTitle>

<AppHeader>
    <div class="actions">
        <nav class="windows">
            @foreach (var window in Windows)
            {
                <button class="@(window == _window ? "active" : null)" @onclick="() => SetWindowAsync(window)">
                    @Label(window)
                </button>
            }
        </nav>
        <button type="button" class="primary" disabled="@_status.IsRunning" @onclick="RunNowAsync">
            @(_status.IsRunning ? "Testing…" : "Run now")
        </button>
    </div>
</AppHeader>

<main>
    <section class="card">
        <div class="card-head">
            <h2>Latest test</h2>
            @if (_latest is { } latest)
            {
                <span class="hint" title="@Time(latest.Timestamp)">@RelativeTime.Format(latest.Timestamp, _now) · @latest.Server</span>
            }
        </div>

        <p class="scan-status">
            @if (_status.IsRunning)
            {
                <span class="scanning">Measuring @(_status.Phase ?? "")…</span>
            }
            @if (_status.NextRun is { } next && !_status.IsRunning)
            {
                <span>Next scheduled test <strong>@Time(next)</strong></span>
            }
            else if (!Options.Value.Enabled)
            {
                <span>Scheduled tests are off.</span>
            }
            <span>Each test transfers about @Megabytes(Options.Value.DownloadBytes + Options.Value.UploadBytes).</span>
        </p>

        @if (_latest is null)
        {
            <p class="empty">No speed test yet. Press “Run now” or wait for the first scheduled one.</p>
        }
        else
        {
            @if (_latest.Error is not null)
            {
                <p class="error" role="alert">Failed: @_latest.Error</p>
            }

            <dl class="stats big">
                <div><dt>Download</dt><dd>@Mbps(_latest.DownloadMbps)</dd></div>
                <div><dt>Upload</dt><dd>@Mbps(_latest.UploadMbps)</dd></div>
                <div><dt>Latency</dt><dd>@Ms(_latest.LatencyMs)</dd></div>
                <div>
                    <dt>Bufferbloat</dt>
                    <dd>
                        @if (_latest.Bufferbloat?.Grade is { } grade)
                        {
                            <span class="badge @GradeClass(grade)" title="Extra latency under load: @Ms(_latest.Bufferbloat.WorstIncreaseMs)">@Bufferbloat.Label(grade)</span>
                        }
                        else
                        {
                            <text>–</text>
                        }
                    </dd>
                </div>
            </dl>

            @if (_latest.Bufferbloat is { } bloat)
            {
                <dl class="stats">
                    <div><dt>Ping idle</dt><dd>@Ms(bloat.IdleMs)</dd></div>
                    <div><dt>Ping downloading</dt><dd>@Ms(bloat.DownloadMs) @Increase(bloat.DownloadIncreaseMs)</dd></div>
                    <div><dt>Ping uploading</dt><dd>@Ms(bloat.UploadMs) @Increase(bloat.UploadIncreaseMs)</dd></div>
                </dl>
                <p class="hint">
                    Bufferbloat is the extra delay your router or modem adds while the line is busy. A or A+ means
                    video calls and games stay smooth while someone downloads; C or worse usually improves with
                    SQM / Smart Queue on the router.
                </p>
            }
        }
    </section>

    <section class="card">
        <div class="card-head">
            <h2>Contract</h2>
            <span class="hint">Last @Label(_window), against the speeds in your Internet contract</span>
        </div>

        @if (_contract.IsEmpty)
        {
            <p class="empty">
                Enter the speeds in your contract to see whether the line keeps them. Many contracts state a
                guaranteed minimum next to the advertised “up to” speed: that is the one that counts.
            </p>
        }
        else
        {
            <dl class="contract-check">
                @foreach (var (direction, check) in Checks())
                {
                    <div>
                        <dt>
                            @direction
                            <span class="badge @ContractFormat.VerdictClass(check.Verdict)">@ContractFormat.Verdict(check.Verdict)</span>
                        </dt>
                        <dd>@ContractFormat.Describe(direction.ToLowerInvariant(), check)</dd>
                    </div>
                }
            </dl>
        }

        <details class="contract-edit" open="@_contract.IsEmpty">
            <summary>@(_contract.IsEmpty ? "Enter the contract" : "Edit the contract")</summary>
            <form class="form-grid" @onsubmit="SaveContractAsync">
                <label>Download (Mbps)
                    <input type="number" min="0" step="any" @bind="_download" />
                </label>
                <label>Upload (Mbps)
                    <input type="number" min="0" step="any" @bind="_upload" />
                </label>
                <label>Guaranteed minimum download (Mbps)
                    <input type="number" min="0" step="any" @bind="_minDownload" />
                </label>
                <label>Guaranteed minimum upload (Mbps)
                    <input type="number" min="0" step="any" @bind="_minUpload" />
                </label>
                <div class="form-actions">
                    <button type="submit" class="primary">Save</button>
                </div>
            </form>
            @if (_contractError is not null)
            {
                <p class="error" role="alert">@_contractError</p>
            }
            <p class="hint">
                Leave a field empty if the contract does not state it. Without a guaranteed minimum, a test counts as
                too slow below half the advertised speed. The contract also fills in the report and, unless alert
                thresholds are configured, sends an alert for each test below the minimum.
            </p>
        </details>
    </section>

    <section class="card">
        <div class="card-head">
            <h2>History</h2>
            <span class="hint">@_summary.Count tests@(_summary.Failed > 0 ? $", {_summary.Failed} failed" : "")</span>
        </div>

        <dl class="stats">
            <div><dt>Avg down</dt><dd>@Mbps(_summary.AvgDownloadMbps)</dd></div>
            <div><dt>Min down</dt><dd>@Mbps(_summary.MinDownloadMbps)</dd></div>
            <div><dt>Avg up</dt><dd>@Mbps(_summary.AvgUploadMbps)</dd></div>
            <div><dt>Min up</dt><dd>@Mbps(_summary.MinUploadMbps)</dd></div>
            <div><dt>Avg latency</dt><dd>@Ms(_summary.AvgLatencyMs)</dd></div>
        </dl>

        <SpeedChart Results="_results" From="_from" To="_now" WindowLabel="@Label(_window)"
                    DownloadThresholdMbps="@_check.Download?.ThresholdMbps" UploadThresholdMbps="@_check.Upload?.ThresholdMbps" />

        @if (_results.Count > 0)
        {
            <div class="table-wrap">
                <table class="devices summary">
                    <thead>
                        <tr>
                            <th scope="col">Time</th>
                            <th scope="col">Download</th>
                            <th scope="col">Upload</th>
                            <th scope="col">Latency</th>
                            <th scope="col">Bufferbloat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in _results.OrderByDescending(r => r.Timestamp))
                        {
                            <tr class="@(result.Success ? null : "offline")">
                                <td>
                                    @Time(result.Timestamp)
                                    @if (!result.Success)
                                    {
                                        <span class="tag offline" title="@result.Error">failed</span>
                                    }
                                </td>
                                <td class="@Below(result.Success ? result.DownloadMbps : null, _check.Download)">@Mbps(result.DownloadMbps)</td>
                                <td class="@Below(result.Success ? result.UploadMbps : null, _check.Upload)">@Mbps(result.UploadMbps)</td>
                                <td>@Ms(result.LatencyMs)</td>
                                <td>
                                    @if (result.Bufferbloat?.Grade is { } rowGrade)
                                    {
                                        <span class="badge @GradeClass(rowGrade)" title="+@Ms(result.Bufferbloat.WorstIncreaseMs) under load">@Bufferbloat.Label(rowGrade)</span>
                                    }
                                    else
                                    {
                                        <text>–</text>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@code {
    private static readonly TimeSpan[] Windows = [TimeSpan.FromDays(7), TimeSpan.FromDays(30)];

    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private readonly CancellationTokenSource _cts = new();
    private TimeSpan _window = Windows[0];
    private DateTimeOffset _from;
    private DateTimeOffset _now;
    private SpeedTestStatus _status = SpeedTestStatus.Idle;
    private SpeedTestResult? _latest;
    private IReadOnlyList<SpeedTestResult> _results = [];
    private SpeedTestSummary _summary = SpeedTestSummary.From([]);
    private bool _wasRunning;
    private ContractSpeeds _contract = ContractSpeeds.None;
    private ContractReport _check = ContractReport.Empty;
    private double? _download;
    private double? _upload;
    private double? _minDownload;
    private double? _minUpload;
    private string? _contractError;

    protected override async Task OnInitializedAsync()
    {
        Runner.Changed += OnChanged;
        _contract = await Contracts.GetAsync();
        (_download, _upload, _minDownload, _minUpload) =
            (_contract.DownloadMbps, _contract.UploadMbps, _contract.MinDownloadMbps, _contract.MinUploadMbps);
        await LoadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    private void OnChanged() =>
        _ = InvokeAsync(async () =>
        {
            _status = Runner.Status;

            // Reload the history once, when a test (ours or the scheduler's) finishes.
            if (_wasRunning && !_status.IsRunning)
            {
                await LoadAsync();
            }

            _wasRunning = _status.IsRunning;
            StateHasChanged();
        });

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _status = Runner.Status;
        _wasRunning = _status.IsRunning;
        _now = DateTimeOffset.UtcNow;
        _from = _now - _window;
        _results = await Store.GetSinceAsync(_from);
        _latest = await Store.GetLatestAsync();
        _summary = SpeedTestSummary.From(_results);
        _check = ContractCheck.Evaluate(_contract, _results);
    }

    private async Task SaveContractAsync()
    {
        if (!ContractSpeeds.TryCreate(_download, _upload, _minDownload, _minUpload, out var contract, out _contractError))
        {
            return;
        }

        await Contracts.SaveAsync(contract);
        _contract = contract;
        _check = ContractCheck.Evaluate(_contract, _results);
    }

    private IEnumerable<(string Direction, SpeedVersusContract Check)> Checks()
    {
        if (_check.Download is { } down)
        {
            yield return ("Download", down);
        }

        if (_check.Upload is { } up)
        {
            yield return ("Upload", up);
        }
    }

    private static string? Below(double? measured, SpeedVersusContract? check) =>
        ContractFormat.IsBelow(measured, check) ? "below-contract" : null;

    private Task RunNowAsync()
    {
        // Runs in the background; progress arrives through Runner.Changed.
        _ = Task.Run(() => Runner.RunAsync());
        return Task.CompletedTask;
    }

    private static string Mbps(double? value) =>
        value is null ? "–" : value.Value.ToString(value < 10 ? "0.00" : "0.0", CultureInfo.InvariantCulture) + " Mbps";

    private static string Ms(double? value) =>
        value is null ? "–" : value.Value.ToString(value < 10 ? "0.0" : "0", CultureInfo.InvariantCulture) + " ms";

    private static string Increase(double? value) =>
        value is null ? "" : $"(+{Ms(value)})";

    private static string GradeClass(BufferbloatGrade grade) => grade switch
    {
        BufferbloatGrade.APlus or BufferbloatGrade.A => "good",
        BufferbloatGrade.B or BufferbloatGrade.C => "fair",
        _ => "poor",
    };

    private static string Megabytes(long bytes) =>
        (bytes / 1_000_000.0).ToString("0", CultureInfo.InvariantCulture) + " MB";

    private static string Time(DateTimeOffset time) =>
        time.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static string Label(TimeSpan window) => $"{window.TotalDays:0}d";

    public void Dispose()
    {
        Runner.Changed -= OnChanged;
        _cts.Cancel();
    }
}
