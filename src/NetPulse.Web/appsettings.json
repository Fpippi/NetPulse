{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetPulse": {
    "IntervalSeconds": 5,
    "TimeoutMs": 1000,
    "RetentionDays": 30,
    "DatabasePath": "data/netpulse.db",
    "Targets": [ "gateway", "1.1.1.1", "8.8.8.8" ]
  }
}
