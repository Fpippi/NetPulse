{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetPulse": {
    "IntervalSeconds": 5,
    "TimeoutMs": 1000,
    "RetentionDays": 30,
    "DatabasePath": "data/netpulse.db",
    "Targets": [ "gateway", "1.1.1.1", "8.8.8.8" ],
    "Ipv6": "Auto",
    "Outages": {
      "ConsecutiveLosses": 3,
      "RetentionDays": 365,
      "TraceRoute": true,
      "TraceMaxHops": 20
    },
    "SpeedTest": {
      "Enabled": true,
      "IntervalMinutes": 360,
      "DownloadBytes": 25000000,
      "UploadBytes": 10000000
    },
    "Discovery": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "Subnet": "",
      "OfflineAfterMissedScans": 2
    },
    "Notifications": {
      "NtfyUrl": "",
      "TelegramBotToken": "",
      "TelegramChatId": "",
      "WebhookUrl": "",
      "Events": {
        "Outages": true,
        "NewDevices": true,
        "DeviceOffline": false,
        "SpeedTests": true
      },
      "MinDownloadMbps": 0,
      "MinUploadMbps": 0
    },
    "LoadTest": {
      "ReceiverEnabled": false,
      "Port": 5201
    }
  }
}
