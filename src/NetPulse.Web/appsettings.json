{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetPulse": {
    "IntervalSeconds": 5,
    "TimeoutMs": 1000,
    "RetentionDays": 30,
    "DatabasePath": "data/netpulse.db",
    "Targets": [ "gateway", "1.1.1.1", "8.8.8.8" ],
    "Outages": {
      "ConsecutiveLosses": 3,
      "RetentionDays": 365
    },
    "Discovery": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "Subnet": "",
      "OfflineAfterMissedScans": 2
    },
    "LoadTest": {
      "ReceiverEnabled": false,
      "Port": 5201
    }
  }
}
