{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetPulse": {
    "IntervalSeconds": 5,
    "TimeoutMs": 1000,
    "RetentionDays": 30,
    "DatabasePath": "data/netpulse.db",
    "Targets": [ "gateway", "1.1.1.1", "8.8.8.8" ],
    "Ipv6": "Auto",
    "Auth": {
      "Password": "",
      "ApiToken": "",
      "SessionDays": 30
    },
    "Outages": {
      "ConsecutiveLosses": 3,
      "RetentionDays": 365,
      "TraceRoute": true,
      "TraceMaxHops": 20
    },
    "Degradation": {
      "Enabled": true,
      "WindowMinutes": 5,
      "MinSamples": 10
    },
    "SpeedTest": {
      "Enabled": true,
      "IntervalMinutes": 360,
      "DownloadBytes": 25000000,
      "UploadBytes": 10000000
    },
    "PublicIp": {
      "Enabled": true,
      "Url": "https://1.1.1.1/cdn-cgi/trace",
      "IntervalMinutes": 5,
      "CgnatCheck": true
    },
    "Discovery": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "Subnet": "",
      "OfflineAfterMissedScans": 2,
      "WatchIntervalSeconds": 10,
      "WatchMissesToDrop": 3
    },
    "Notifications": {
      "NtfyUrl": "",
      "TelegramBotToken": "",
      "TelegramChatId": "",
      "WebhookUrl": "",
      "Events": {
        "Outages": true,
        "NewDevices": true,
        "DeviceOffline": false,
        "WatchedDevices": true,
        "SpeedTests": true,
        "PublicIp": true,
        "Degradation": true
      },
      "MinDownloadMbps": 0,
      "MinUploadMbps": 0
    },
    "ClientCheck": {
      "Url": "",
      "InternetCheckUrl": "https://cloudflare.com/cdn-cgi/trace",
      "CheckRouter": true
    },
    "LoadTest": {
      "ReceiverEnabled": false,
      "Port": 5201
    }
  }
}
